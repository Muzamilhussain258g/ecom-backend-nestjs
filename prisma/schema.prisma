generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  role           UserRole        @default(customer)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  name           String
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  paymentMethods PaymentMethod[]
  reviews        Review[]
  wishlist       WishList[]
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id               Int      @id @default(autoincrement())
  userId           Int
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  refreshTokenHash String   @unique
  refreshTokenId   String   @unique // <-- NAYA FIELD (jti)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id           Int    @id @default(autoincrement())
  categoryName String
  slug         String
  parentId     Int?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  // products Product[]
  productCategories ProductCategory[]

  @@unique([parentId, categoryName])
  @@unique([parentId, slug])
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  categoryId Int
  productId  Int
  isPrimary  Boolean  @default(false)
  category   Category @relation(fields: [categoryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, categoryId])
  @@index([categoryId])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  basePrice     Decimal
  productStatus Boolean  @default(true)
  hasVariants   Boolean  @default(false)

  reviews           Review[]
  wishlistedBy      WishList[]
  productCategories ProductCategory[]
  variantTypes      ProductVariantType[]
  variantValues     ProductVariantValue[]
  variants          Variant[]
  images            ProductImage[]
}

model Review {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  review    String
  stars     Decimal
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

// this is for making the global variant types eg: color, size, material,etc 
model VariantType {
  id        Int    @id @default(autoincrement())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)

  values   VariantValue[]
  products ProductVariantType[]
}

// this is for assigning the value to the variant types eg: (color=blue,red,etc), (size=small,large,xl,etc), etc 
model VariantValue {
  id            Int         @id @default(autoincrement())
  variantTypeId Int
  value         String
  code          String
  metadata      Json?
  sortOrder     Int         @default(0)
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Restrict)

  products          ProductVariantValue[]
  combinationValues VariantCombinationValue[]
  productImages     ProductImage[]

  @@unique([variantTypeId, code])
  @@index([variantTypeId])
}
// this is for assigninng the variant types to the products eg: product1 has color, size, material, etc
model ProductVariantType {
  id            Int         @id @default(autoincrement())
  productId     Int
  variantTypeId Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Restrict)

  @@unique([productId, variantTypeId])
  @@index([variantTypeId])
}

// this is for assigning the value to the product variant types eg: product1 has color=blue,red, size=small,large, material=cotton,polyester, etc 
model ProductVariantValue {
  id             Int          @id @default(autoincrement())
  productId      Int
  variantValueId Int
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantValue   VariantValue @relation(fields: [variantValueId], references: [id], onDelete: Restrict)

  @@unique([productId, variantValueId])
  @@index([variantValueId])
}

model Variant {
  id             Int     @id @default(autoincrement())
  productId      Int
  combinationKey String
  stock          Int
  sku            String  @unique
  price          Decimal
  isActive       Boolean @default(true)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  combinationValues VariantCombinationValue[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@unique([productId, combinationKey])
  @@index([productId])
}

model VariantCombinationValue {
  id             Int          @id @default(autoincrement())
  variantId      Int
  variantValueId Int
  variant        Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantValue   VariantValue @relation(fields: [variantValueId], references: [id], onDelete: Restrict)

  @@unique([variantId, variantValueId])
  @@index([variantValueId])
}

model ProductImage {
  id              Int           @id @default(autoincrement())
  productId       Int
  variantValueId  Int?
  productImageUrl String
  imageId         String
  isPrimary       Boolean
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantValue    VariantValue? @relation(fields: [variantValueId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([variantValueId])
}

model WishList {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique @map("user_id")
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id             Int     @id @default(autoincrement())
  cartId         Int     @map("cart_id")
  variantId      Int     @map("variant_id")
  isSelected     Boolean @map("is_selected")
  buyingQuantity Int     @map("buying_quantity")
  cart           Cart    @relation(fields: [cartId], references: [id])
  variant        Variant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                 Int         @id @default(autoincrement())
  userId             Int
  shippingAddressId  Int?
  shippingFullName   String
  shippingPhone      String
  shippingStreet     String
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  shippingCountry    String
  totalAmount        Decimal
  status             OrderStatus @default(pending)
  createdAt          DateTime    @default(now()) @map("created_at")
  shippingAddress    Address?    @relation(fields: [shippingAddressId], references: [id])
  user               User        @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payments           Payment[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Decimal
  order     Order   @relation(fields: [orderId], references: [id])
  variant   Variant @relation(fields: [variantId], references: [id])
}

model PaymentMethod {
  id        Int               @id @default(autoincrement())
  userId    Int
  type      PaymentMethodType
  provider  PaymentProvider
  cardLast4 String?
  cardBrand String?
  isDefault Boolean
  createdAt DateTime          @default(now())
  payments  Payment[]
  user      User              @relation(fields: [userId], references: [id])
}

model Payment {
  id              Int            @id @default(autoincrement())
  orderId         Int
  paymentMethodId Int?
  transactionId   String?        @unique
  amount          Decimal
  currency        String
  status          PaymentStatus  @default(pending)
  gateway         PaymentGateway
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  order           Order          @relation(fields: [orderId], references: [id])
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
}

model Address {
  id         Int         @id @default(autoincrement())
  userId     Int
  label      AddressType
  fullName   String
  phone      String
  street     String
  city       String
  province   String
  postalCode String
  country    String
  isDefault  Boolean
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  orders     Order[]
}

enum UserRole {
  customer
  admin
  seller
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
}

enum PaymentGateway {
  payfast
  jazzcash
  easypaisa
  cod
}

enum PaymentMethodType {
  card
  wallet
  bank_transfer
  cod
}

enum PaymentProvider {
  visa
  mastercard
  jazzcash
  easypaisa
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum AddressType {
  home
  office
  other
}
